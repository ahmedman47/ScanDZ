<!doctype html><html lang="en"><head><meta charset="utf-8"><style>{{ css }}
body { font-family: "Segoe UI", Arial, sans-serif }
.bar { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 3px solid #333; padding-bottom: 3mm; margin-bottom: 6mm }
.bar .title { margin: 0 }
.box { border: none; padding: 0 } th { background: #333; color: #fff; border: none }
td { border: none; border-bottom: 1px solid #bbb }
.totals td { border-bottom: 1px solid #bbb } .totals tr.grand td { background: #fff; border-top: 2px solid #333; font-size: 12pt }
</style></head><body>
{% import "_macros.j2" as m %}
<div class="bar"><div class="title">{{ title }}</div><div style="text-align:right">{{ m.meta(inv, L, dt) }}</div></div>
<div class="row"><div class="box"><small>{{ L.seller }}</small><br>{{ m.party(inv.seller, L) }}</div>
<div class="box"><small>{{ L.buyer }}</small><br>{{ m.party(inv.buyer, L, ids=False) }}</div></div>
{{ m.lines(inv, L, amt, qty) }}
{{ m.totals(inv, L, amt, pct, unit) }}
<div class="footer small">{{ m.words(inv, L, amt, unit) }}</div>
</body></html>

<!doctype html><html lang="fr"><head><meta charset="utf-8"><style>{{ css }}
.hdr { text-align: center; margin-bottom: 4mm } .hdr .n { font-size: 15pt; font-weight: 700 }
.title { text-align: center; font-size: 16pt }
.stamp { width: 40mm; height: 40mm; border: 2.5px solid #1b3a99; border-radius: 50%; color: #1b3a99; opacity: .42;
  transform: rotate(-14deg); display: flex; align-items: center; justify-content: center; text-align: center;
  font-weight: 700; font-size: 8pt; padding: 5mm; margin: -34mm 0 0 24mm; box-shadow: inset 0 0 0 3px #fff, inset 0 0 0 4px #1b3a99 }
.sig { margin-top: 10mm; font-size: 9pt } .sig .line { border-bottom: 1px solid #333; width: 55mm; height: 14mm }
</style></head><body>
{% import "_macros.j2" as m %}
<div class="hdr"><div class="n">{{ inv.seller.name }}</div><div class="small">{{ inv.seller.address }} | NIF {{ inv.seller.nif }} | NIS {{ inv.seller.nis }} | RC {{ inv.seller.rc }} | AI {{ inv.seller.ai }}</div></div>
<div class="title">{{ title }}</div>
<div class="row"><div class="box"><small>{{ L.buyer }}</small><br>{{ m.party(inv.buyer, L, ids=False) }}</div><div class="box">{{ m.meta(inv, L, dt) }}</div></div>
{{ m.lines(inv, L, amt, qty) }}
{{ m.totals(inv, L, amt, pct, unit) }}
<div class="stamp">{{ inv.seller.name }}<br>{{ inv.seller.address }}</div>
<div class="sig">{{ L.stamp }}<div class="line"></div></div>
<div class="footer small">{{ m.words(inv, L, amt, unit) }}</div>
</body></html>

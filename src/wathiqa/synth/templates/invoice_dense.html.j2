<!doctype html><html lang="fr"><head><meta charset="utf-8"><style>{{ css }}
body { font-size: 8pt; padding: 12mm } .box { border: none; padding: 0 }
.title { font-size: 14pt; margin: 4mm 0 1mm } .meta { margin-bottom: 3mm }
th { background: #fff; border: none; border-bottom: 1.5px solid #000; padding: 1mm }
td { border: none; padding: .8mm 1mm } tbody tr:nth-child(even) td { background: #f0f0f0 }
.totals { width: 65mm } .totals td { border: none; border-bottom: .5px solid #888 } .totals tr.grand td { background: #fff; font-size: 10pt }
.footer { margin-top: 6mm }
</style></head><body>
{% import "_macros.j2" as m %}
<div class="row"><div class="box">{{ m.party(inv.seller, L) }}</div><div class="box" style="text-align:right"><small>{{ L.buyer }}</small><br>{{ m.party(inv.buyer, L, ids=False) }}</div></div>
<div class="title">{{ title }} {{ L.number }} <span class="ltr">{{ inv.invoice_number }}</span></div>
<div class="meta">{% if inv.issue_date %}{{ L.date }} : {{ dt(inv.issue_date) }} &nbsp;{% endif %}{% if inv.due_date %}{{ L.due }} : {{ dt(inv.due_date) }} &nbsp;{% endif %}{{ L.payment }} : {{ inv.payment_method }}</div>
{{ m.lines(inv, L, amt, qty, index=True) }}
{{ m.totals(inv, L, amt, pct, unit) }}
<div class="footer small">{{ m.words(inv, L, amt, unit) }}</div>
</body></html>
